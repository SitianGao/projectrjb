# EduAgent shared environment
#
# Copy this file to .env in the project root for local startup.

# Backend service
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./eduagent.db
SEED_DEMO_DATA=true

# ── LLM Provider ──────────────────────────
LLM_PRIMARY=deepseek

# DeepSeek
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 讯飞星火（比赛正式环境启用，当前开发不启用）
SPARK_ENABLED=false
SPARK_API_PASSWORD=
SPARK_API_URL=https://spark-api-open.xf-yun.com/v1/chat/completions
SPARK_MODEL=4.0Ultra

# OpenAI（备用）
OPENAI_API_KEY=

# LLM 调用配置
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
# 比赛录制建议保持严格模式；模型失败时明确报错，不伪装为 Agent 成功。
LLM_STRICT_MODE=true

# RAG / embeddings
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_AUTO_INIT=true
RAG_STRICT_MODE=true
RESOURCE_STRICT_MODE=true

# ── 演示课程 ──────────────────────────────
# 启动时自动初始化演示课程（幂等）
INIT_DEMO_COURSE=true

# ── 前端 ──────────────────────────────────
FRONTEND_PORT=5173
VITE_USE_MOCK=false
