# EduAgent shared environment
#
# Copy this file to .env in the project root for local startup.

# Backend service
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./eduagent.db
SEED_DEMO_DATA=true

# LLM provider
LLM_PRIMARY=spark
SPARK_API_PASSWORD=
SPARK_API_URL=https://spark-api-open.xf-yun.com/v1/chat/completions
SPARK_MODEL=4.0Ultra
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# RAG / embeddings
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

