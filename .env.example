# EduAgent shared environment
#
# Copy this file to .env in the project root for local startup.
# 模型配置统一由 backend/.env 管理，此文件只保留项目级非密钥配置。

# Backend service
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./eduagent.db
SEED_DEMO_DATA=true

# LLM 调用配置
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_STRICT_MODE=true

# RAG / embeddings
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_AUTO_INIT=true
RAG_STRICT_MODE=true
RESOURCE_STRICT_MODE=true

# ── 演示课程 ──────────────────────────────
INIT_DEMO_COURSE=true

# ── 前端 ──────────────────────────────────
FRONTEND_PORT=5173
VITE_USE_MOCK=false
