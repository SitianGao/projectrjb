# =============================================================
# EduAgent 生产环境配置模板
# 复制此文件为 .env 并填入真实配置
# =============================================================

# ── 端口配置 ──────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── LLM 主模型选择 ───────────────────────
LLM_PRIMARY=spark

# ── 讯飞星火配置 ─────────────────────────
SPARK_ENABLED=true
SPARK_PROTOCOL=http
SPARK_API_PASSWORD=your_spark_api_password_here
SPARK_MODEL=4.0Ultra
SPARK_APP_ID=your_app_id
SPARK_API_SECRET=your_api_secret
SPARK_API_KEY=your_api_key
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1/
SPARK_API_URL=https://spark-api-open.xf-yun.com/v1/chat/completions

# ── DeepSeek 备用模型 ────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── OpenAI 备用模型 ──────────────────────
OPENAI_API_KEY=

# ── LLM 调用参数 ─────────────────────────
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_STRICT_MODE=false

# ── RAG / 嵌入模型 ───────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_STRICT_MODE=true
RESOURCE_STRICT_MODE=true

# ── 认证模式 ─────────────────────────────
AUTH_REQUIRED=false

# ── PPT 服务 ─────────────────────────────
SPARK_PPT_ENABLED=true
SPARK_PPT_API_KEY=
SPARK_PPT_API_URL=https://zwapi.xfyun.cn/api/ppt/v2
