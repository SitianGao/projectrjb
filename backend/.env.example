# ============================================================
# EduAgent 环境变量模板
# 复制为 .env 并填入真实值（.env 已在 .gitignore 中排除）
# ============================================================

# ---- 数据库 ----
DATABASE_URL=sqlite:///./eduagent.db

# ---- 讯飞星火 Spark 4.0（主力模型）----
SPARK_API_KEY=your_spark_api_key_here
SPARK_API_SECRET=your_spark_api_secret_here
SPARK_APP_ID=your_spark_app_id_here

# ---- DeepSeek（备选模型，OpenAI 兼容接口）----
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ---- OpenAI（可选备选）----
OPENAI_API_KEY=your_openai_api_key_here

# ---- LLM 调用配置 ----
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# ---- 向量库 ----
CHROMA_PERSIST_DIR=./chroma_data

# ---- 嵌入模型 ----
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
