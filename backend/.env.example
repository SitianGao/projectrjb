# =============================================
# EduAgent 环境变量配置模板
# 复制此文件为 .env 并填入真实凭证
# =============================================

# ── 主模型选择 ──────────────────────
# spark = 讯飞星火（主）  deepseek = DeepSeek（主）
LLM_PRIMARY=spark

# ── 讯飞星火 Spark HTTP API ────────
# 在 https://console.xfyun.cn/ 申请
SPARK_API_PASSWORD=your_spark_api_password_here
SPARK_API_URL=https://spark-api-open.xf-yun.com/agent/v1/chat/completions
SPARK_MODEL=spark-2.0-flash

# ── DeepSeek API（备选）────────────
# 在 https://platform.deepseek.com/ 申请
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── 数据库 ─────────────────────────
# DATABASE_URL=sqlite:///./eduagent.db
