# =============================================
# EduAgent 后端环境变量配置模板
# 复制此文件为 .env 并填入真实凭证
# =============================================

# ── 主模型选择 ──────────────────────
LLM_PRIMARY=spark

# ── 讯飞星火 Spark X2 HTTP ─────────
SPARK_ENABLED=true
SPARK_PROTOCOL=http
SPARK_API_PASSWORD=your_spark_api_password
SPARK_MODEL=spark-x
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/x2/
SPARK_API_URL=https://spark-api-open.xf-yun.com/x2/chat/completions

# ── DeepSeek（备用）────────────────
DEEPSEEK_API_KEY=

# ── 认证 ───────────────────────────
AUTH_REQUIRED=true
